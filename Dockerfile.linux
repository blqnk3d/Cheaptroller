FROM node:18-bookworm

ARG FLUTTER_VERSION=3.38.7
ARG FLUTTER_HOME=/opt/flutter

# Install system dependencies for Node.js native addon and Flutter Linux
RUN apt-get update && apt-get install -y \
    build-essential \
    python3 \
    python3-dev \
    python-is-python3 \
    make \
    g++ \
    cmake \
    ninja-build \
    pkg-config \
    libgtk-3-dev \
    libglib2.0-dev \
    libgio-cil-dev \
    wget \
    unzip \
    curl \
    git \
    zip \
    && rm -rf /var/lib/apt/lists/*

# Install Flutter SDK
RUN wget -q https://storage.googleapis.com/flutter_infra_release/releases/stable/linux/flutter_linux_${FLUTTER_VERSION}-stable.tar.xz -O /tmp/flutter.tar.xz && \
    tar xf /tmp/flutter.tar.xz -C /opt/ && \
    rm /tmp/flutter.tar.xz

ENV PATH=${FLUTTER_HOME}/bin:${FLUTTER_HOME}/bin/cache/dart-sdk/bin:${PATH}
ENV FLUTTER_HOME=${FLUTTER_HOME}

# Pre-cache Flutter
RUN flutter config --no-analytics && \
    flutter doctor

WORKDIR /app

# Build Backend Binary
COPY Backend_controler /app/backend
WORKDIR /app/backend

# Install dependencies and compile native addon
RUN npm install

# Build backend binary with pkg
RUN npm install -g pkg && \
    pkg . --targets node18-linux-x64 --output /app/dist/cheaptroller-backend

# Build Flutter Linux Desktop
WORKDIR /app
COPY Game_Controler /app/flutter-app
WORKDIR /app/flutter-app

RUN flutter pub get && \
    flutter build linux --release

# Final output directory
RUN mkdir -p /app/dist && \
    cp -r /app/flutter-app/build/linux/x64/release/bundle /app/dist/game_controler_linux && \
    cp /app/flutter-app/build/linux/x64/release/bundle/game_controler /app/dist/game_controler_linux/ 2>/dev/null || true

WORKDIR /app

# Outputs:
# - /app/dist/cheaptroller-backend (Node.js backend binary)
# - /app/dist/game_controler_linux/ (Flutter Linux desktop app)
